{% extends "base.html.jinja" %}
{% block title %}Notatka{% endblock %}
{% block content %}
    <section class="w-full grid gap-4 mt-4">
        <div class="flex flex-col bg-white rounded-lg shadow-md p-4">
            <h3 class="text-md font-semibold mb-2">Treść notatki</h3>
            <p class="mb-4">{{ note.content }}</p>
            <p class="text-sm text-gray-600">Dodano: {{ note.created_at }}</p>
            <p class="mt-2"><span class="font-semibold">Książka:</span> <a href="{% url 'book' note.book.id %}" class="text-blue-500 hover:underline">{{ note.book.title }}</a></p>
        </div>
    </section>
{% endblock %}
