{% extends "base.html.jinja" %}
{% block title %}Lista wydawców{% endblock %}
{% block content %}
    <section class="w-full grid gap-4 mt-4">
        <div class="flex flex-col bg-white rounded-lg shadow-md p-4">
            <h3 class="text-md font-semibold mb-2">Wydawcy</h3>
            {% for publisher in publishers %}
                <div class="border-b py-2">
                    <a href="{% url 'publisher' publisher.id %}" class="text-blue-500 hover:underline">{{ publisher.name }}</a>
                    <p class="text-sm text-gray-600">{{ publisher.get_country_display }}{% if publisher.founded_year %}, od {{ publisher.founded_year }}{% endif %}</p>
                </div>
            {% empty %}
                <p class="text-gray-600">Brak wydawców do wyświetlenia.</p>
            {% endfor %}
        </div>
    </section>
{% endblock %}
